# Environment Variables — GROMAR Backend
#
# IMPORTANT:
# DATABASE_URL must be a PostgreSQL connection string for Vercel production.
# Do not use a local sqlite file path here, because Vercel serverless does not
# provide a persistent filesystem.

# Server
PORT=5000
NODE_ENV=development

# JWT Secret (ganti dengan random string panjang)
JWT_SECRET=gromar_super_secret_jwt_key_2024_change_this

# Database (PostgreSQL)
# Jalankan docker start postgres-gromar
# Example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Also required in Vercel Dashboard:
# - JWT_SECRET
# - FRONTEND_URL
# - MIDTRANS_SERVER_KEY
# - MIDTRANS_CLIENT_KEY
# - MIDTRANS_IS_PRODUCTION

# Midtrans Payment Gateway
# Dapatkan dari: https://dashboard.sandbox.midtrans.com -> Settings -> Access Keys
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# Frontend URL(s) for CORS.
# You can use multiple origins separated by commas, for example:
# FRONTEND_URL=http://localhost:3000,https://gromar-contract.vercel.app,https://preview-gromar-contract.vercel.app
FRONTEND_URL=http://localhost:3000

# ─────────────────────────────────────────────────────
# AI Chat Provider Configuration
# ─────────────────────────────────────────────────────
# Pilih provider utama: gemini | openai | groq
# Jika provider utama gagal, sistem otomatis fallback ke provider lain yang tersedia
AI_PROVIDER=gemini

# Google Gemini (default)
# Get API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# OpenAI (optional)
# Get API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Groq (optional — fast & free tier)
# Get API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
